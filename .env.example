# ============================================
# AI Trader Agent - Environment Configuration
# ============================================
# 复制此文件为 .env 并填入实际值
# Usage: cp .env.example .env

# --------------------------------------------
# API Keys (Required)
# --------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx  # Claude API
OPENAI_API_KEY=sk-xxx          # OpenAI API (可选)
ZHIPU_API_KEY=xxx              # 智谱 GLM API Key
THIRD_PARTY_API_KEY=xxx        # 通用第三方 API Key (优先级低于 ZHIPU_API_KEY)

# --------------------------------------------
# Third Party API Configuration
# --------------------------------------------
THIRD_PARTY_BASE_URL=https://open.bigmodel.cn/api/paas/v4  # 智谱 GLM Base URL
THIRD_PARTY_MODEL=glm-4-flash                              # 默认模型名称

# --------------------------------------------
# Local Model Configuration
# --------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:7b-q5_K_M
LOCAL_MODEL_PATH=D:/Models/Qwen2.5-7B-Instruct-Q5_K_M.gguf

# --------------------------------------------
# Database Configuration
# --------------------------------------------
SQLITE_DB_PATH=data/trading.db
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --------------------------------------------
# Data Sources
# --------------------------------------------
TUSHARE_TOKEN=  # Optional, leave empty if not using
AKSHARE_ENABLED=true

# --------------------------------------------
# Account Configuration
# --------------------------------------------
INITIAL_CASH=1000000.0
COMMISSION_RATE=0.0003  # 万三佣金
STAMP_DUTY_RATE=0.001   # 千一印花税（卖出）
SLIPPAGE_RATE=0.0005    # 万五滑点

# --------------------------------------------
# Risk Control
# --------------------------------------------
MAX_POSITION_RATIO=0.30  # 单只股票最大仓位
MAX_DAILY_TRADES=10      # 单日最大交易笔数
COOLDOWN_MINUTES=30      # 冷却时间（分钟）

# --------------------------------------------
# Survival Levels
# --------------------------------------------
SURVIVAL_NORMAL_DRAWDOWN_THRESHOLD=0.10
SURVIVAL_LOW_COMPUTE_DRAWDOWN_THRESHOLD=0.20
SURVIVAL_CRITICAL_DRAWDOWN_THRESHOLD=0.30

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/trader.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# --------------------------------------------
# Monitoring (Phase 4)
# --------------------------------------------
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost

# --------------------------------------------
# Development
# --------------------------------------------
DEBUG=false
TEST_MODE=false
MOCK_DATA=false
